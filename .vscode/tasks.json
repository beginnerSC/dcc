{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: cl.exe build active file",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "/Zi",
                "/std:c++23",
                "${file}",
                "/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": ["$msCompile"]
        }, 
        {
            "label": "CMake: build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: config and build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset=vcpkg"
            ],
            "group": "build",
            "dependsOn": ["CMake: build (Debug)"]
        }
    ]
}
